#-------Cấu hình JWT-------#    
SECRET_KEY="your_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

#------Cấu hình Admin_key------#
ADMIN_SETUP_KEY = "your_key"


#-------Cấu hình email--------#
MAIL_USERNAME= your_mail
MAIL_PASSWORD= your app password
MAIL_FROM=your_mail
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=your app name support

# MAIL_USERNAME → email dùng để gửi mail
# MAIL_PASSWORD → App Password
# MAIL_FROM → email hiển thị người gửi
# MAIL_FROM_NAME → tên hiển thị (brand/app của bạn)

#-------Cấu hình Front-end-------#

FRONTEND_URL=http://localhost:3000

#-------Cấu hình Stripe------------#
STRIPE_SECRET_KEY=your STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=your STRIPE_PUBLISHABLE_KEY

#---------API KEY MODEL ---------------#
GEMINI_API_KEY=your API google key

#--------API_KEY_PINECONE-----#
PINECONE_API_KEY= your PINECONE_API_KEY
PINECONE_INDEX_NAME=your PINECONE_INDEX_NAME

#--------SQL Server (pyodbc)-----#
# DB_HOST=LAPTOP-9TFF98TE
# DB_NAME=EcommerceAI
